{
  "expo": {
    "name": "HelloBot AI Tarot & Fortune",
    "slug": "hellobot-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hellobot",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.hellobot.mobile",
      "backgroundColor": "#000000"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "package": "ai.hellobot.mobile"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset"
    ]
  }
}
